@inherits LayoutComponentBase
@implements IDisposable
@inject IState<ThemeState> ThemeState
@inject IDispatcher Dispatcher

<div class="page @(ThemeState.Value.IsDarkMode ? "dark-mode" : "light-mode")">
    @if (ThemeState.Value.IsSidebarVisible) {
        <div class="sidebar">
            <NavMenu />
        </div>
    } else {
        <button class="btn btn-link sidebar-btn" @onclick="ToggleSidebar">
            <i class="fa-solid fa-bars"></i>
        </button>
    }

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized() {
        base.OnInitialized();
        ThemeState.StateChanged += StateChanged;
    }

    private void StateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);
    
    private void ToggleSidebar() => Dispatcher.Dispatch(new ToggleSidebarAction());

    public void Dispose() {
        ThemeState.StateChanged -= StateChanged;
    }
}