@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IState<ThemeState> ThemeState
@inject IDispatcher Dispatcher

<div class="page @(ThemeState.Value.IsDarkMode ? "dark-mode" : "light-mode")">
    @if (ThemeState.Value.IsSidebarVisible) {
        <div class="sidebar">
            <NavMenu />
        </div>
    } else {
        <button class="btn btn-link sidebar-btn" @onclick="ToggleSidebar">
            <i class="fa-solid fa-bars"></i>
        </button>
    }

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized() {
        base.OnInitialized();
        ThemeState.StateChanged += StateChanged;
        SynchronizeNativeTheme();
    }

    private async void StateChanged(object? sender, EventArgs e) {
        try {
            await InvokeAsync(() => {
                SynchronizeNativeTheme();
                StateHasChanged();
            });
        } catch (Exception ex) {
            await DispatchExceptionAsync(ex);
        }
    }

    private void ToggleSidebar() => Dispatcher.Dispatch(new ToggleSidebarAction());

    private void SynchronizeNativeTheme() {
        var application = Microsoft.Maui.Controls.Application.Current;
        if (application is null) {
            return;
        }

        var backgroundColor = ThemeState.Value.IsDarkMode
            ? Microsoft.Maui.Graphics.Color.FromArgb("#121212")
            : Microsoft.Maui.Graphics.Colors.White;

        foreach (var window in application.Windows) {
            if (window.Page is { } page) {
                page.BackgroundColor = backgroundColor;
            }
        }

#if ANDROID
        if (Microsoft.Maui.ApplicationModel.Platform.CurrentActivity is MainActivity activity) {
            activity.SetStatusBarTheme(ThemeState.Value.IsDarkMode);
        }
#endif
    }

    public ValueTask DisposeAsync() {
        ThemeState.StateChanged -= StateChanged;
        return ValueTask.CompletedTask;
    }
}
