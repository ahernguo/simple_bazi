@inject PeriodFavorabilityService FavorabilityService

<div class="card analysis-card p-3 mt-3">
    <h5 class="card-title analysis-card-title">
        <i class="fa-solid fa-shield-halved me-2" aria-hidden="true"></i>犯太歲與生肖相沖
    </h5>
    <hr class="analysis-card-divider" aria-hidden="true" />

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="border rounded p-3 h-100">
                <div class="text-secondary mb-1">本命生肖</div>
                <div class="fs-5 fw-semibold">
                    @Analysis.NatalZodiac（年支
                    <ElementText Element="Analysis.NatalYearBranch.ToWuXing()" Text="@(Analysis.NatalYearBranch.ToZhiString())" />）
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="border rounded p-3 h-100">
                <div class="text-secondary mb-1">@Analysis.Year 流年生肖</div>
                <div class="fs-5 fw-semibold">
                    @Analysis.AnnualZodiac（<ElementText Element="Analysis.AnnualStem.ToWuXing()" Text="@(Analysis.AnnualStem.ToGanString())" /><ElementText Element="Analysis.AnnualBranch.ToWuXing()" Text="@(Analysis.AnnualBranch.ToZhiString())" />年）
                </div>
            </div>
        </div>
    </div>

    @if (Info is not null) {
        var annualStemTenGod = Analysis.AnnualStem.ToShiShen(Info.DayZhu.Gan);
        var annualBranchTenGod = Analysis.AnnualBranch.ToShiShen(Info.DayZhu.Gan);
        <div class="border rounded p-3 mb-3">
            <div>
                <strong>流年十神功能：</strong>
                天干 <TenGodText Info="Info"
                                    TenGod="annualStemTenGod"
                                    Mode="TenGodDisplayMode.Favorability"
                                    FavorableOverride="GetFavorability(annualStemTenGod)"
                                    FavorabilityReason="@GetFavorabilityReason()" />、
                地支 <TenGodText Info="Info"
                                    TenGod="annualBranchTenGod"
                                    Mode="TenGodDisplayMode.Favorability"
                                    FavorableOverride="GetFavorability(annualBranchTenGod)"
                                    FavorabilityReason="@GetFavorabilityReason()" />
            </div>
        </div>
    }

    @if (Analysis.HasDirectTaiSui) {
        <div class="alert alert-warning analysis-item-explanation">
            <strong>直接犯太歲：</strong>@string.Join("、", Analysis.DirectInteractions.Select(GetDirectLabel))。
            <ul class="mt-2 mb-0">
                @foreach (TaiSuiInteractionType interaction in Analysis.DirectInteractions) {
                    <li class="mb-1" @key="interaction">
                        <strong>@GetDirectLabel(interaction)：</strong>@GetDirectIssue(interaction)
                    </li>
                }
            </ul>
        </div>
    } else {
        <div class="alert alert-success analysis-item-explanation">
            本命年支與所選流年未形成值、沖、刑、害、破，沒有直接犯太歲。
        </div>
    }

    @if (Analysis.IsZodiacClash) {
        <div class="alert alert-warning analysis-item-explanation">
            <strong>生肖相沖：</strong>@(Analysis.NatalZodiac)與@(Analysis.AnnualZodiac)形成
            <ElementText Element="Analysis.NatalYearBranch.ToWuXing()" Text="@(Analysis.NatalYearBranch.ToZhiString())" /><ElementText Element="Analysis.AnnualBranch.ToWuXing()" Text="@(Analysis.AnnualBranch.ToZhiString())" />六沖，較需留意移動、變動與摩擦。
        </div>
    } else {
        <p><strong>生肖相沖：</strong>本命生肖與所選流年生肖未形成六沖。</p>
    }

    <h6 class="mt-3">四柱延伸比較</h6>
    @if (Analysis.HasIndirectTaiSui) {
        <ul class="mb-3">
            @foreach (TaiSuiPillarInteraction interaction in Analysis.IndirectInteractions) {
                <li class="mb-3" @key="interaction.PillarName">
                    <AnalysisItem CssClass="mb-0" AlertClass="alert-warning">
                        <ChildContent>
                            @interaction.PillarName 地支
                            <ElementText Element="interaction.NatalBranch.ToWuXing()" Text="@(interaction.NatalBranch.ToZhiString())" />
                            與流年地支
                            <ElementText Element="Analysis.AnnualBranch.ToWuXing()" Text="@(Analysis.AnnualBranch.ToZhiString())" />
                            形成
                            @string.Join("、", interaction.Interactions.Select(GetIndirectLabel))，列為間接犯太歲。
                        </ChildContent>
                        <ExplanationContent>
                            @foreach (var interactionType in interaction.Interactions) {
                                <div class="mb-1" @key="interactionType">
                                    <strong><span>間接</span>@GetDirectLabel(interactionType)：</strong>@GetIndirectIssue(interactionType)；作用通常小於年支直接犯太歲，但仍要處理對應的現實風險。
                                </div>
                            }
                        </ExplanationContent>
                    </AnalysisItem>
                </li>
            }
        </ul>
    } else {
        <p>已納入的月、日、時支與所選流年未形成間接犯太歲。</p>
    }

    @if (Analysis.HasReinforcedInteraction) {
        <h6 class="mt-3">原局互動再次集中</h6>
        <ul class="mb-3">
            @foreach (var reinforcement in Analysis.ReinforcedInteractions!) {
                <li class="mb-1" @key="(reinforcement.RepeatedPillarName, reinforcement.RelatedPillarName)">
                    流年地支與@reinforcement.RepeatedPillarName 地支
                    <ElementText Element="reinforcement.RepeatedBranch.ToWuXing()" Text="@(reinforcement.RepeatedBranch.ToZhiString())" />
                    同支，使原局和@reinforcement.RelatedPillarName 地支
                    <ElementText Element="reinforcement.RelatedBranch.ToWuXing()" Text="@(reinforcement.RelatedBranch.ToZhiString())" />
                    的 @string.Join("、", reinforcement.Interactions.Select(GetIndirectLabel)) 再次集中。
                </li>
            }
        </ul>
    }

    @if (!Analysis.IsHourPillarIncluded) {
        <div class="alert alert-info analysis-item-explanation">
            因出生時辰不確定，本次未將時柱納入比較；補齊準確時辰後，結果可能改變。
        </div>
    }

    <TopicNotice CssClass="mb-0">
        犯太歲與六沖是流年互動及變動提醒，不代表一定倒楣或必然發生特定事件；仍須配合喜用神、大運、完整命盤與現實狀況判讀。
    </TopicNotice>
</div>

@code {
    /// <summary>取得要呈現的犯太歲分析。</summary>
    [Parameter, EditorRequired]
    public TaiSuiAnalysisResult Analysis { get; set; } = null!;

    /// <summary>取得本命資料，用於呈現流年十神與喜忌。</summary>
    [Parameter]
    public BaZiInfo? Info { get; set; }

    private bool? GetFavorability(ShiShen tenGod) {
        DaYunFavorabilityContext? context = GetDaYunContext();
        return Info is null || context is null
            ? null
            : FavorabilityService.IsPeriodFavorable(Info, context, tenGod);
    }

    private string? GetFavorabilityReason() {
        DaYunFavorabilityContext? context = GetDaYunContext();
        return Info is null || context is null
            ? null
            : FavorabilityService.GetPeriodReason(Info, context);
    }

    private DaYunFavorabilityContext? GetDaYunContext() {
        if (Info is null) {
            return null;
        }

        DaYun? daYun = Info.DaYunList.FirstOrDefault(item =>
            Analysis.Year >= item.StartYear && Analysis.Year <= item.EndYear
        );
        return daYun is null
            ? null
            : FavorabilityService.EvaluateDaYun(Info, daYun, Analysis.Year);
    }

    private static string GetDirectLabel(TaiSuiInteractionType interaction) {
        return interaction switch {
            TaiSuiInteractionType.SameBranch => "值太歲",
            TaiSuiInteractionType.SixClash => "沖太歲",
            TaiSuiInteractionType.Punishment => "刑太歲",
            TaiSuiInteractionType.SixHarm => "害太歲",
            TaiSuiInteractionType.SixBreak => "破太歲",
            _ => throw new ArgumentOutOfRangeException(nameof(interaction), interaction, null)
        };
    }

    private static string GetIndirectLabel(TaiSuiInteractionType interaction) {
        return interaction switch {
            TaiSuiInteractionType.SameBranch => "同支",
            TaiSuiInteractionType.SixClash => "相沖",
            TaiSuiInteractionType.Punishment => "相刑",
            TaiSuiInteractionType.SixHarm => "相害",
            TaiSuiInteractionType.SixBreak => "相破",
            _ => throw new ArgumentOutOfRangeException(nameof(interaction), interaction, null)
        };
    }

    private static string GetDirectIssue(TaiSuiInteractionType interaction) {
        return interaction switch {
            TaiSuiInteractionType.SameBranch => "本命年使年度變動與自我壓力更集中，作息、健康與重要決策都要主動管理。",
            TaiSuiInteractionType.SixClash => "移動、搬家、工作與想法變動容易加速；交通、防跌與行程緩衝要提高標準。",
            TaiSuiInteractionType.Punishment => "糾結、摩擦與壓力容易累積，重要溝通與責任分工要留下紀錄。",
            TaiSuiInteractionType.SixHarm => "信任敏感、誤解與人際阻礙較明顯，先查證再回應。",
            TaiSuiInteractionType.SixBreak => "預算、承諾或計畫較容易被打斷與重排；其作用通常弱於值、沖。",
            _ => throw new ArgumentOutOfRangeException(nameof(interaction), interaction, null)
        };
    }

    private static string GetIndirectIssue(TaiSuiInteractionType interaction) {
        return interaction switch {
            TaiSuiInteractionType.SameBranch => "該宮位的變動與責任更集中，先管理作息及對應家人／生活領域。",
            TaiSuiInteractionType.SixClash => "該宮位的移動、變動與摩擦加速，交通與行程需要更大緩衝。",
            TaiSuiInteractionType.Punishment => "該宮位的糾結、摩擦與壓力容易累積。",
            TaiSuiInteractionType.SixHarm => "該宮位較易出現誤解、信任敏感或人事阻礙。",
            TaiSuiInteractionType.SixBreak => "該宮位的計畫、預算或承諾較容易被打斷與重排。",
            _ => throw new ArgumentOutOfRangeException(nameof(interaction), interaction, null)
        };
    }

}
