@if (Analyses.Any(analysis => analysis.HasContent)) {
    var visibleAnalyses = Analyses.Where(analysis => analysis.HasContent).ToList();

    <hr class="fortune-yin-section-divider" aria-hidden="true" />
    <p class="text-secondary mb-4">
        <strong>下方非《徐玉蘭的人生八字應用課》的內容，來源為古籍與網路資料</strong>
    </p>

    @foreach (var analysis in visibleAnalyses) {
        @if (analysis.FuYin.HasFuYin) {
            <div class="card analysis-card p-4 mb-4" @key="@($"{analysis.PeriodName}-伏吟")">
                <h5 class="card-title analysis-card-title">
                    <i class="fa-solid fa-repeat me-2" aria-hidden="true"></i>@analysis.PeriodName 伏吟
                </h5>
                <p class="analysis-card-description text-secondary">@analysis.PeriodName 與較早出現的命柱或運柱，其天干、地支完全相同。</p>
                <hr class="analysis-card-divider" aria-hidden="true" />
                <ul>
                    @foreach (var match in analysis.FuYin.Matches) {
                        <li class="mb-3" @key="match">
                            <AnalysisItem CssClass="mb-0" AlertClass="alert-info">
                                <ChildContent>
                                    <strong>@match.SourcePillar.Id</strong>
                                    <GanZhiText Value="match.SourcePillar" />
                                    &nbsp;與&nbsp;
                                    <strong>@match.PeriodPillar.Id</strong>
                                    <GanZhiText Value="match.PeriodPillar" />
                                    &nbsp;形成伏吟。
                                </ChildContent>
                                <ExplanationContent>@match.Situation</ExplanationContent>
                            </AnalysisItem>
                        </li>
                    }
                </ul>

                <TopicNotice CssClass="mt-3 mb-0">
                    <ul class="compatibility-note-list mb-0">
                        <li class="mb-1"><span class="text-warning">傳統意涵</span>&ensp;伏吟偏向重複、停滯、舊事再現，同一課題可能需要反覆整理</li>
                        <li class="mb-1"><span class="text-success">判讀原則</span>&ensp;伏吟本身不是固定吉凶，還要配合喜忌、十神、宮位與其他合沖一起看</li>
                        <li class="mb-1"><span class="text-success">因應方式</span>&ensp;先處理舊問題與未完成事項，重要決策保留檢查點，避免因急於突破而忽略既有風險</li>
                    </ul>
                </TopicNotice>
            </div>
        }

        @if (analysis.FanYin.HasContent) {
            <div class="card analysis-card p-4 mb-4" @key="@($"{analysis.PeriodName}-反吟")">
                <h5 class="card-title analysis-card-title">
                    <i class="fa-solid fa-repeat me-2" aria-hidden="true"></i>@analysis.PeriodName 反吟
                </h5>

                @if (analysis.FanYin.HasFanYin) {
                    <p class="analysis-card-description text-secondary">@analysis.PeriodName 與較早出現的命柱或運柱，有天干相剋、地支相剋或相沖的狀況。</p>
                    <hr class="analysis-card-divider" aria-hidden="true" />
                    <ul>
                        @foreach (var match in analysis.FanYin.Matches) {
                            <li class="mb-3" @key="match">
                                <AnalysisItem CssClass="mb-0" AlertClass="alert-warning">
                                    <ChildContent>
                                        <strong>@match.SourcePillar.Id</strong>
                                        <GanZhiText Value="match.SourcePillar" />
                                        &nbsp;與&nbsp;
                                        <strong>@match.PeriodPillar.Id</strong>
                                        <GanZhiText Value="match.PeriodPillar" />
                                        &nbsp;形成反吟。
                                    </ChildContent>
                                    <ExplanationContent>@match.Situation</ExplanationContent>
                                </AnalysisItem>
                            </li>
                        }
                    </ul>
                } else {
                    <hr class="analysis-card-divider" aria-hidden="true" />
                }

                @foreach (var combination in analysis.FanYin.Combinations) {
                    <div class="alert alert-info analysis-item-explanation mt-3 mb-0" @key="combination">
                        <strong>
                            @combination.FirstFanYinPillar.Id
                            <GanZhiText Value="combination.FirstFanYinPillar" />
                            與
                            @combination.SecondFanYinPillar.Id
                            <GanZhiText Value="combination.SecondFanYinPillar" />
                        </strong>
                        原有反吟；其中
                        <strong>@combination.CombinedPillar.Id <GanZhiText Value="combination.CombinedPillar" /></strong>
                        又與
                        <strong>@combination.CombiningPillar.Id <GanZhiText Value="combination.CombiningPillar" /></strong>
                        以天干五合、地支六合形成<strong>@analysis.PeriodName 合絆</strong>；合絆與原有反吟同時保留，是否減輕及作用優先級仍須依完整命局核對。
                    </div>
                }

                <TopicNotice CssClass="mt-3 mb-0">
                    <ul class="compatibility-note-list mb-0">
                        <li class="mb-1"><span class="text-warning">傳統意涵</span>&ensp;反吟偏向對立、拉扯與變動，可能表現在移動、角色調整或既有安排重整</li>
                        <li class="mb-1"><span class="text-success">判讀原則</span>&ensp;變動不必然是壞事；若沖動忌神或有其他有利組合，也可能成為調整與突破的契機</li>
                        <li class="mb-1"><span class="text-success">合絆原則</span>&ensp;此處須同時形成天干五合與地支六合才標示合絆；合與原有沖剋並存，不先假定已減弱或消失</li>
                    </ul>
                </TopicNotice>
            </div>
        }
    }

    @if (visibleAnalyses.Any(analysis => !analysis.FuYin.IncludesHourPillar)) {
        <div class="alert alert-info analysis-item-explanation">
            因出生時辰不確定，本次未將時柱納入伏吟、反吟與合絆判斷；補齊準確時辰後，結果可能改變。
        </div>
    }
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<FortuneYinAnalysisResult> Analyses { get; set; } = [];

}
