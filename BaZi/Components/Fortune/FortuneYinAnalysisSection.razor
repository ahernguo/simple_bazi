@if (Analyses.Any(analysis => analysis.HasContent)) {
    var visibleAnalyses = Analyses.Where(analysis => analysis.HasContent).ToList();

    <hr class="fortune-yin-section-divider" aria-hidden="true" />
    <p class="text-secondary mb-4">
        <strong>下方非《徐玉蘭的人生八字應用課》的內容，來源為古籍與網路資料</strong>
    </p>

    @foreach (var analysis in visibleAnalyses) {
        @if (analysis.FuYin.HasFuYin) {
            <div class="card p-4 mb-4" @key="@($"{analysis.PeriodName}-伏吟")">
                <h5 class="card-title border-bottom pb-2">
                    <i class="fa-solid fa-repeat me-2" aria-hidden="true"></i>@analysis.PeriodName 伏吟
                </h5>
                <p>@analysis.PeriodName 與較早出現的命柱或運柱，其天干、地支完全相同。</p>
                <ul>
                    @foreach (var match in analysis.FuYin.Matches) {
                        <li class="mb-2" @key="match">
                            <strong>@match.SourcePillar.Id</strong>
                            <span class="@GetElementColorClass(match.SourcePillar.Gan.ToWuXing())">@match.SourcePillar.Gan.ToGanString()</span><span class="@GetElementColorClass(match.SourcePillar.Zhi.ToWuXing())">@match.SourcePillar.Zhi.ToZhiString()</span>
                            &nbsp;與&nbsp;
                            <strong>@match.PeriodPillar.Id</strong>
                            <span class="@GetElementColorClass(match.PeriodPillar.Gan.ToWuXing())">@match.PeriodPillar.Gan.ToGanString()</span><span class="@GetElementColorClass(match.PeriodPillar.Zhi.ToWuXing())">@match.PeriodPillar.Zhi.ToZhiString()</span>
                            &nbsp;形成伏吟。
                        </li>
                        <li class="mb-2" @key="@($"{match.SourcePillar.Id}-{match.PeriodPillar.Id}-伏吟說明")">
                            @match.Situation
                        </li>
                    }
                </ul>

                <TopicNotice CssClass="mt-3 mb-0">
                    <ul class="compatibility-note-list mb-0">
                        <li class="mb-1"><span class="text-warning">傳統意涵</span>&ensp;伏吟偏向重複、停滯、舊事再現，同一課題可能需要反覆整理</li>
                        <li class="mb-1"><span class="text-success">判讀原則</span>&ensp;伏吟本身不是固定吉凶，還要配合喜忌、十神、宮位與其他合沖一起看</li>
                        <li class="mb-1"><span class="text-success">因應方式</span>&ensp;先處理舊問題與未完成事項，重要決策保留檢查點，避免因急於突破而忽略既有風險</li>
                    </ul>
                </TopicNotice>
            </div>
        }

        @if (analysis.FanYin.HasContent) {
            <div class="card p-4 mb-4" @key="@($"{analysis.PeriodName}-反吟")">
                <h5 class="card-title border-bottom pb-2">
                    <i class="fa-solid fa-repeat me-2" aria-hidden="true"></i>@analysis.PeriodName 反吟
                </h5>

                @if (analysis.FanYin.HasFanYin) {
                    <p>@analysis.PeriodName 與較早出現的命柱或運柱，有天干相剋、地支相剋或相沖的狀況。</p>
                    <ul>
                        @foreach (var match in analysis.FanYin.Matches) {
                            <li class="mb-2" @key="match">
                                <strong>@match.SourcePillar.Id</strong>
                                <span class="@GetElementColorClass(match.SourcePillar.Gan.ToWuXing())">@match.SourcePillar.Gan.ToGanString()</span><span class="@GetElementColorClass(match.SourcePillar.Zhi.ToWuXing())">@match.SourcePillar.Zhi.ToZhiString()</span>
                                &nbsp;與&nbsp;
                                <strong>@match.PeriodPillar.Id</strong>
                                <span class="@GetElementColorClass(match.PeriodPillar.Gan.ToWuXing())">@match.PeriodPillar.Gan.ToGanString()</span><span class="@GetElementColorClass(match.PeriodPillar.Zhi.ToWuXing())">@match.PeriodPillar.Zhi.ToZhiString()</span>
                                &nbsp;形成反吟。
                            </li>
                            <li class="mb-2" @key="@($"{match.SourcePillar.Id}-{match.PeriodPillar.Id}-反吟說明")">
                                @match.Situation
                            </li>
                        }
                    </ul>
                }

                @foreach (var mitigation in analysis.FanYin.Mitigations) {
                    <div class="alert alert-success mt-3 mb-0" @key="mitigation">
                        <strong>
                            @mitigation.FirstFanYinPillar.Id
                            @mitigation.FirstFanYinPillar.Gan.ToGanString()@mitigation.FirstFanYinPillar.Zhi.ToZhiString()
                            與
                            @mitigation.SecondFanYinPillar.Id
                            @mitigation.SecondFanYinPillar.Gan.ToGanString()@mitigation.SecondFanYinPillar.Zhi.ToZhiString()
                        </strong>
                        原有反吟；其中
                        <strong>@mitigation.CombinedPillar.Id @mitigation.CombinedPillar.Gan.ToGanString()@mitigation.CombinedPillar.Zhi.ToZhiString()</strong>
                        被
                        <strong>@mitigation.CombiningPillar.Id @mitigation.CombiningPillar.Gan.ToGanString()@mitigation.CombiningPillar.Zhi.ToZhiString()</strong>
                        以天干五合、地支六合合住。可視為被<strong>@analysis.PeriodName 合走（合絆）</strong>，@GetMitigationDuration(analysis.PeriodName)反吟狀況會較為減輕；原有沖剋仍保留，不視為完全消失。
                    </div>
                }

                <TopicNotice CssClass="mt-3 mb-0">
                    <ul class="compatibility-note-list mb-0">
                        <li class="mb-1"><span class="text-warning">傳統意涵</span>&ensp;反吟偏向對立、拉扯與變動，可能表現在移動、角色調整或既有安排重整</li>
                        <li class="mb-1"><span class="text-success">判讀原則</span>&ensp;變動不必然是壞事；若沖動忌神或有其他有利組合，也可能成為調整與突破的契機</li>
                        <li class="mb-1"><span class="text-success">合走原則</span>&ensp;此處須同時形成天干五合與地支六合才標示合走，僅代表合絆後作用減弱，不會刪除原有反吟</li>
                    </ul>
                </TopicNotice>
            </div>
        }
    }

    @if (visibleAnalyses.Any(analysis => !analysis.FuYin.IncludesHourPillar)) {
        <div class="alert alert-info">
            因出生時辰不確定，本次未將時柱納入伏吟、反吟與合走判斷；補齊準確時辰後，結果可能改變。
        </div>
    }
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<FortuneYinAnalysisResult> Analyses { get; set; } = [];

    private static string GetMitigationDuration(string periodName) {
        return periodName switch {
            "大運" => "在這段大運期間，",
            "流年" => "在這個流年內，",
            "流月" => "在這個流月內，",
            _ => "在這段期間，"
        };
    }

    private static string GetElementColorClass(WuXing element) {
        return element switch {
            WuXing.Mu => "element-wood",
            WuXing.Huo => "element-fire",
            WuXing.Tu => "element-earth",
            WuXing.Jin => "element-metal",
            WuXing.Shui => "element-water",
            _ => string.Empty
        };
    }
}
