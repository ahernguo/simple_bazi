<div class="compatibility-result">
    <div class="card p-4 mb-4">
        <h5 class="card-title border-bottom pb-2">命盤摘要</h5>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <h6>自己</h6>
                    <div>@FormatBirth(Result.Self)</div>
                    <div>生肖：@Result.Self.ShengXiao</div>
                    <div>
                        日柱：<span class="@GetElementColorClass(Result.Self.DayZhu.GanWuXing) fw-semibold">@Result.Self.DayZhu.Gan.ToGanString()</span><span class="@GetElementColorClass(Result.Self.DayZhu.ZhiWuXing) fw-semibold">@Result.Self.DayZhu.Zhi.ToZhiString()</span>
                    </div>
                    <div>
                        日主／格局：<span class="@GetElementColorClass(Result.Self.RiZhu) fw-semibold">@Result.Self.RiZhu.ToWuXingString()</span>／@Result.Self.StrengthStatus.ToGeJuString()
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <h6>對方</h6>
                    <div>@FormatBirth(Result.Other)</div>
                    <div>生肖：@Result.Other.ShengXiao</div>
                    <div>
                        日柱：<span class="@GetElementColorClass(Result.Other.DayZhu.GanWuXing) fw-semibold">@Result.Other.DayZhu.Gan.ToGanString()</span><span class="@GetElementColorClass(Result.Other.DayZhu.ZhiWuXing) fw-semibold">@Result.Other.DayZhu.Zhi.ToZhiString()</span>
                    </div>
                    <div>
                        日主／格局：<span class="@GetElementColorClass(Result.Other.RiZhu) fw-semibold">@Result.Other.RiZhu.ToWuXingString()</span>／@Result.Other.StrengthStatus.ToGeJuString()
                    </div>
                </div>
            </div>
        </div>
    </div>

    @foreach (var section in Result.Sections) {
        <div class="card p-4 mb-4 compatibility-section @GetToneClass(section.Tone)" @key="section.Title">
            <h5 class="card-title border-bottom pb-2">
                <i class="fa-solid @GetToneIcon(section.Tone) me-2"></i>@section.Title
            </h5>
            <p>@FormatText(section.Summary, section.TenGodSubject, section.TenGodShowsFavorability)</p>
            @if (section.Details.Count > 0) {
                <ul class="mb-0">
                    @foreach (var detail in section.Details) {
                        <li class="mb-2">@FormatText(detail, section.TenGodSubject, section.TenGodShowsFavorability)</li>
                    }
                </ul>
            }
            @if (section.Notes is { Count: > 0 }) {
                <TopicNotice CssClass="mt-3 mb-0">
                    <ul class="compatibility-note-list mb-0">
                        @foreach (var note in section.Notes) {
                            <li class="mb-1">@FormatText(note, section.TenGodSubject, section.TenGodShowsFavorability)</li>
                        }
                    </ul>
                </TopicNotice>
            }
        </div>
    }

    <AnalysisCard Title="使用限制" Icon="fa-shield-heart" CssClass="mb-4">
        <ul class="mb-0">
            @foreach (var limitation in Result.Limitations) {
                <li class="mb-2">@limitation</li>
            }
        </ul>
    </AnalysisCard>
</div>
