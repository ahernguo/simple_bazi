<div class="compatibility-result">
    <div class="card analysis-card p-4 mb-4">
        <h5 class="card-title analysis-card-title">命盤摘要</h5>
        <hr class="analysis-card-divider" aria-hidden="true" />
        <div class="row g-3">
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <h6>自己</h6>
                    <div>@FormatBirth(Result.Self)</div>
                    <div>生肖：@Result.Self.ShengXiao</div>
                    <div>
                        日柱：<GanZhiText Value="Result.Self.DayZhu" />
                    </div>
                    <div>
                        日主／格局：<ElementText Element="Result.Self.RiZhu" />／@Result.Self.StrengthStatus.ToGeJuString()
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <h6>對方</h6>
                    <div>@FormatBirth(Result.Other)</div>
                    <div>生肖：@Result.Other.ShengXiao</div>
                    <div>
                        日柱：<GanZhiText Value="Result.Other.DayZhu" />
                    </div>
                    <div>
                        日主／格局：<ElementText Element="Result.Other.RiZhu" />／@Result.Other.StrengthStatus.ToGeJuString()
                    </div>
                </div>
            </div>
        </div>
    </div>

    @foreach (var section in Result.Sections) {
        var subject = GetSubjectInfo(section.TenGodSubject);

        <div class="card analysis-card p-4 mb-4" @key="section.Title">
            <h5 class="card-title analysis-card-title">
                <i class="fa-solid @GetToneIcon(section.Tone) me-2"></i>@section.Title
            </h5>
            <hr class="analysis-card-divider" aria-hidden="true" />
            <p class="mb-2">
                <SemanticText Text="@section.Summary"
                              Info="subject.Info"
                              SubjectLabel="@subject.Label"
                              TenGodMode="GetTenGodMode(section)" />
            </p>
            @if (section.Details.Count > 0) {
                <div class="alert alert-info analysis-item-explanation compatibility-transparent-alert mb-2">
                    <ul class="mb-0">
                        @foreach (var detail in section.Details) {
                            <li class="mb-1">
                                <SemanticText Text="@detail"
                                              Info="subject.Info"
                                              SubjectLabel="@subject.Label"
                                              TenGodMode="GetTenGodMode(section)" />
                            </li>
                        }
                    </ul>
                </div>
            }
            @if (section.Notes is { Count: > 0 }) {
                <TopicNotice CssClass="mb-0">
                    <ul class="compatibility-note-list mb-0">
                        @foreach (var note in section.Notes) {
                            <li class="mb-1">
                                <SemanticText Text="@note"
                                              Info="subject.Info"
                                              SubjectLabel="@subject.Label"
                                              TenGodMode="GetTenGodMode(section)" />
                            </li>
                        }
                    </ul>
                </TopicNotice>
            }
        </div>
    }

    <TopicNotice Icon="fa-shield-heart" CssClass="mb-4">
        <ul class="mb-0">
            @foreach (var limitation in Result.Limitations) {
                <li class="mb-2">@limitation</li>
            }
        </ul>
    </TopicNotice>
</div>
