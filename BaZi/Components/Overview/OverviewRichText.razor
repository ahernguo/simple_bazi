@inject PersonalOverviewTextService TextService

@foreach (var segment in _segments) {
    if (segment.Kind == PersonalOverviewTextKind.Plain) {
        @segment.Text
    } else {
        <span class="@GetCssClass(segment)">@segment.Text</span>
    }
}

@code {
    [Parameter]
    [EditorRequired]
    public string Text { get; set; } = string.Empty;

    private IReadOnlyList<PersonalOverviewTextSegment> _segments = [];

    protected override void OnParametersSet() {
        _segments = TextService.Segment(Text);
    }

    private static string GetCssClass(PersonalOverviewTextSegment segment) {
        if (segment.Kind == PersonalOverviewTextKind.TenGod) {
            return "overview-ten-god";
        }

        return segment.Element switch {
            WuXing.Mu => "element-wood fw-semibold",
            WuXing.Huo => "element-fire fw-semibold",
            WuXing.Tu => "element-earth fw-semibold",
            WuXing.Jin => "element-metal fw-semibold",
            WuXing.Shui => "element-water fw-semibold",
            _ => string.Empty
        };
    }
}
