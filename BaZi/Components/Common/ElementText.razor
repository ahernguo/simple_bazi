<span class="@CssClass">@(Text ?? Element.ToWuXingString())</span>

@code {
    [Parameter, EditorRequired]
    public WuXing Element { get; set; }

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public bool Emphasized { get; set; } = true;

    private string CssClass => $"{ElementPresentationService.GetCssClass(Element)}{(Emphasized ? " fw-semibold" : string.Empty)}";
}
