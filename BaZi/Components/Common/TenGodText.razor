@inject PeriodFavorabilityService FavorabilityService
@inject TenGodPresentationService PresentationService

<span class="@_presentation.CssClass" title="@_presentation.Tooltip">@_presentation.Text</span>

@code {
    [Parameter]
    public BaZiInfo? Info { get; set; }

    [Parameter, EditorRequired]
    public ShiShen TenGod { get; set; }

    [Parameter]
    public TenGodDisplayMode Mode { get; set; } = TenGodDisplayMode.Reference;

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public bool ShowFavorabilityLabel { get; set; }

    [Parameter]
    public bool? FavorableOverride { get; set; }

    [Parameter]
    public string? FavorabilityReason { get; set; }

    [Parameter]
    public string? SubjectLabel { get; set; }

    private TenGodPresentation _presentation = new(
        string.Empty,
        "topic-ten-god-reference",
        null,
        null,
        null
    );

    protected override void OnParametersSet() {
        if (Mode == TenGodDisplayMode.Reference || Info is null) {
            _presentation = PresentationService.CreateReference(TenGod, Text);
            return;
        }

        bool isFavorable = FavorableOverride ?? FavorabilityService.IsNatalFavorable(Info, TenGod);
        string reason = FavorabilityReason
            ?? (string.IsNullOrWhiteSpace(SubjectLabel)
                ? "依本命格局"
                : $"依{SubjectLabel}本命格局");
        _presentation = PresentationService.CreateFavorability(
            Info,
            TenGod,
            isFavorable,
            reason,
            Text,
            ShowFavorabilityLabel
        );
    }
}
