<article class="card analysis-card p-3 @CssClass">
    <h5 class="card-title analysis-card-title">
        @if (!string.IsNullOrWhiteSpace(Icon)) {
            <i class="fa-solid @Icon me-2" aria-hidden="true"></i>
        }
        @Title
    </h5>

    @if (DescriptionContent is not null) {
        <div class="analysis-card-description text-secondary">
            @DescriptionContent
        </div>
    }

    <hr class="analysis-card-divider" aria-hidden="true" />

    <div class="analysis-card-content">
        @ChildContent
    </div>

    @if (NoticeContent is not null) {
        <TopicNotice CssClass="mt-auto mb-0">
            @NoticeContent
        </TopicNotice>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public RenderFragment? DescriptionContent { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    [Parameter]
    public RenderFragment? NoticeContent { get; set; }

    [Parameter]
    public string CssClass { get; set; } = "mt-3";
}
