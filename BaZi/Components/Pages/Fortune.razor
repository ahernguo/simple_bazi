@page "/fortune"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<BaZiState> BaZiState
@inject FortuneService FortuneService
@inject NavigationManager Navigation

@if (BaZiState.Value.Info == null) {
    <div class="alert alert-info">請先回首頁輸入生日。</div>
    <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/")'>回首頁</button>
} else {
    var info = BaZiState.Value.Info;
    <div class="container mt-4">
        <h2 class="mb-4 text-center"><i class="fa-solid fa-road me-2"></i>大運與流年</h2>

        <div class="card p-3 mb-4">
            <h5 class="card-title border-bottom pb-2">大運表 (每十年一運)</h5>
            <div class="table-responsive">
                <table class="table table-bordered text-center">
                    <thead class="table-secondary">
                        <tr>
                            <th>起運年</th>
                            <th>起運歲數</th>
                            <th>大運干支</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dy in info.DaYunList) {
                            <tr class="@(FortuneService.IsCurrentDaYun(dy, info) ? "table-warning" : "")">
                                <td>@dy.StartYear</td>
                                <td>@dy.StartAge</td>
                                <td class="fw-bold">@dy.Gan.ToGanString()@dy.Zhi.ToZhiString()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (FortuneService.HasSelfConflict(info, out var confMs)) {
            @confMs
        }

        @FortuneService.DaYunAnalysis(info)

        <div class="card p-3 mt-3">
            <h5 class="card-title border-bottom pb-2">流年查詢</h5>
            @{
                var liuNianYears = FortuneService.GetLiuNianYears(info);
            }
            @if (liuNianYears.Count == 0) {
                <div class="alert alert-warning mb-0">查無可供查詢的流年資料。</div>
            } else {
                <div class="row g-3 align-items-end">
                    <div class="col-sm-8 col-md-6">
                        <label class="form-label" for="liu-nian-year">年份</label>
                        <select id="liu-nian-year" class="form-select" @bind="_fortunePage.SelectedLiuNianYear">
                            <option value="">請選擇年份</option>
                            @foreach (var year in liuNianYears) {
                                <option value="@year">@year 年</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-4 col-md-3">
                        <button type="button"
                                class="btn btn-primary w-100"
                                disabled="@(_fortunePage.SelectedLiuNianYear is null)"
                                @onclick="QueryLiuNian">
                            <i class="fa-solid fa-magnifying-glass me-2"></i>查詢
                        </button>
                    </div>
                </div>
            }
        </div>

        @if (_fortunePage.QueriedLiuNianYear is int targetYear) {
            @FortuneService.LiuNianAnalysis(info, targetYear)
        }
    </div>
}

@code {
    private readonly FortunePageModel _fortunePage = new();

    private void QueryLiuNian() {
        _fortunePage.QueriedLiuNianYear = _fortunePage.SelectedLiuNianYear;
    }
}
