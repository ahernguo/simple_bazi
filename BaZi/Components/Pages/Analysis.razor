@page "/analysis"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<BaZiState> BaZiState
@inject FuYinAnalysisService FuYinAnalysisService
@inject FanYinAnalysisService FanYinAnalysisService
@inject NavigationManager Navigation

@if (BaZiState.Value.Info == null) {
    <div class="alert alert-info">請先回首頁輸入生日。</div>
    <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/")'>回首頁</button>
} else {
    var info = BaZiState.Value.Info;
    var fuYinResult = FuYinAnalysisService.AnalyzeNatal(info);
    var fanYinResult = FanYinAnalysisService.AnalyzeNatal(info);
    <div class="container mt-4">
        <h2 class="mb-4 text-center"><i class="fa-solid fa-chart-column me-2"></i>命盤分析</h2>

        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card analysis-card p-3 h-100">
                    <h5 class="card-title analysis-card-title">基本資訊</h5>
                    <hr class="analysis-card-divider" aria-hidden="true" />
                    <p><strong>性別：</strong> @info.Gender.ToSexString()</p>
                    <p><strong>國曆：</strong> @info.SolarDate</p>
                    <p><strong>農曆：</strong> @info.LunarDate</p>
                    <p><strong>生肖：</strong> @info.ShengXiao</p>
                    <p><strong>格局：</strong> <span class="badge @GetStrengthBadgeClass(info.StrengthStatus)">@GetStrengthStatusText(info) (@info.StrengthScore%)</span></p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card analysis-card p-3 h-100">
                    <h5 class="card-title analysis-card-title">日主核心</h5>
                    <hr class="analysis-card-divider" aria-hidden="true" />
                    <div class="d-flex align-items-center justify-content-center h-100">
                        <div class="day-master-box text-center">
                            <h1 class="display-1 @GetElementColorClass(info.RiZhu)">@info.DayZhu.Gan.ToGanString()</h1>
                            <div class="fs-4">@info.RiZhuJiXing.ToJiXingString()@info.RiZhu.ToWuXingString()</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="bazi-chart card p-4">
            <div class="row text-center border-bottom pb-2 mb-2 font-weight-bold">
                <div class="col">時柱</div>
                <div class="col">日柱</div>
                <div class="col">月柱</div>
                <div class="col">年柱</div>
            </div>
            <div class="row text-center mb-3">
                <div class="col shishen zhuxing">@info.HourZhu.ZhuXing.ToShenString()</div>
                <div class="col shishen zhuxing">日主</div>
                <div class="col shishen zhuxing">@info.MonthZhu.ZhuXing.ToShenString()</div>
                <div class="col shishen zhuxing">@info.YearZhu.ZhuXing.ToShenString()</div>
            </div>
            <div class="row text-center mb-3 fs-1">
                <div class="col gan @GetElementColorClass(info.HourZhu.GanWuXing)">@info.HourZhu.Gan.ToGanString()</div>
                <div class="col gan @GetElementColorClass(info.DayZhu.GanWuXing)">@info.DayZhu.Gan.ToGanString()</div>
                <div class="col gan @GetElementColorClass(info.MonthZhu.GanWuXing)">@info.MonthZhu.Gan.ToGanString()</div>
                <div class="col gan @GetElementColorClass(info.YearZhu.GanWuXing)">@info.YearZhu.Gan.ToGanString()</div>
            </div>
            <div class="row text-center mb-3 fs-1">
                <div class="col zhi @GetElementColorClass(info.HourZhu.ZhiWuXing)">@info.HourZhu.Zhi.ToZhiString()</div>
                <div class="col zhi @GetElementColorClass(info.DayZhu.ZhiWuXing)">@info.DayZhu.Zhi.ToZhiString()</div>
                <div class="col zhi @GetElementColorClass(info.MonthZhu.ZhiWuXing)">@info.MonthZhu.Zhi.ToZhiString()</div>
                <div class="col zhi @GetElementColorClass(info.YearZhu.ZhiWuXing)">@info.YearZhu.Zhi.ToZhiString()</div>
            </div>
            <div class="row text-center">
                <div class="col fuxing">
                    <div class="row text-center">
                        @foreach (var ts in info.HourZhu.FuXing) {
                            <div @key="ts" class="col shishen">@ts.ToShenString()</div>
                        }
                    </div>
                </div>
                <div class="col fuxing">
                    <div class="row text-center">
                        @foreach (var ts in info.DayZhu.FuXing) {
                            <div @key="ts" class="col shishen">@ts.ToShenString()</div>
                        }
                    </div>
                </div>
                <div class="col fuxing">
                    <div class="row text-center">
                        @foreach (var ts in info.MonthZhu.FuXing) {
                            <div @key="ts" class="col shishen">@ts.ToShenString()</div>
                        }
                    </div>
                </div>
                <div class="col fuxing">
                    <div class="row text-center">
                        @foreach (var ts in info.YearZhu.FuXing) {
                            <div @key="ts" class="col shishen">@ts.ToShenString()</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card analysis-card mt-4 p-4">
            <h5 class="card-title analysis-card-title"><span class="@GetElementColorClass(info.RiZhu)">@info.DayZhu.Gan.ToGanString()@info.RiZhu.ToWuXingString()</span> 日主</h5>
            <hr class="analysis-card-divider" aria-hidden="true" />
            @GetRiZhuDesc(info)
        </div>

        <div class="card analysis-card mt-4 p-4">
            <h5 class="card-title analysis-card-title">@GetStrengthStatusText(info)</h5>
            <hr class="analysis-card-divider" aria-hidden="true" />
            @GetGeJuDesc(info)
        </div>

        <AnalysisCard Title="格局計算明細" Icon="fa-scale-balanced" CssClass="mt-4">
            <ChildContent>
                <div class="table-responsive">
                    <table class="table theme-table table-bordered align-middle mb-3">
                        <thead class="table-secondary">
                            <tr>
                                <th scope="col">柱位</th>
                                <th scope="col">原始五行</th>
                                <th scope="col">定案五行</th>
                                <th scope="col">固定權重</th>
                                <th scope="col">計入分數</th>
                                <th scope="col">判定依據</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var position in info.StrengthCalculation.Positions) {
                                <tr @key="position.Key">
                                    <th scope="row">@position.Label</th>
                                    <td><ElementText Element="position.OriginalElement" /></td>
                                    <td><ElementText Element="position.EffectiveElement" /></td>
                                    <td>@position.Weight%</td>
                                    <td class="@(position.IsSupportive ? "text-success fw-semibold" : "text-secondary")">@position.Score%</td>
                                    <td>@string.Join("；", position.Reasons)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th scope="row" colspan="4">幫身總分</th>
                                <td colspan="2" class="fw-semibold">@info.StrengthScore%</td>
                            </tr>
                            <tr>
                                <th scope="row" colspan="4">總分判斷</th>
                                <td colspan="2" class="fw-semibold">
                                    (分數 &lt; 20) 疑似從弱<br/>
                                    (20 ≤ 分數 &lt; 45) 身弱；(45 ≤ 分數 ≤ 80) 身強<br />
                                    (分數 &gt; 80) 疑似從強
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </ChildContent>
            <NoticeContent>
                <ul>
                    <li>
                        @if (info.RequiresStrengthVerification) {
                            <span>目前分數落在<strong>@GetStrengthStatusText(info)</strong>區間，不能只憑分數定案。必須用多個大運、流年的實際事件與身心狀態複核，確認順勢方向後再採用從格補運。</span>
                        } else {
                            <span>每個柱位只計一次固定權重；四庫、三合、半合、暗拱與三會只會改變該位置的定案五行，不會重複加分。</span>
                        }
                    </li>
                    <li>
                        格局僅表示五行上的能量狀態，並非命主的生理狀態
                        <ul>
                            <li><strong>身弱</strong>&ensp;日主五行佔整體的比例&nbsp;<strong>偏少</strong>，需要多補充幫扶日主的五行能量</li>
                            <li><strong>身強</strong>&ensp;日主五行佔整體的比例&nbsp;<strong>偏多</strong>，需要多耗洩日主的五行能量</li>
                            <li><strong>從弱</strong>&ensp;日主五行佔整體的比例&nbsp;<strong>極端的少</strong>，需要持續耗洩日主的五行能量</li>
                            <li><strong>從強</strong>&ensp;日主五行佔整體的比例&nbsp;<strong>極端的多</strong>，需要持續補充幫扶日主的五行能量</li>
                        </ul>
                    </li>
                </ul>
            </NoticeContent>
        </AnalysisCard>

        <div class="card analysis-card mt-4 p-4">
            <h5 class="card-title analysis-card-title">五行對應</h5>
            <hr class="analysis-card-divider" aria-hidden="true" />
            <div class="row ms-1 me-1 border-bottom-dash">
                <div class="col-1 col-vc-hc @GetElementColorClass(BaZiDefine.Restricting[info.RiZhu])">@BaZiDefine.Restricting[info.RiZhu].ToWuXingString()</div>
                <div class="col-3 col-vc-hc">正財/偏財</div>
                <div class="col-6 col-vc-hl">
                    錢財<br />
                    男性長輩、父親
                    @if (info.Gender == Sex.Male) {
                        <br />
                        <text>婚姻、感情、另一半</text>
                    }
                </div>
            </div>
            <div class="row ms-1 me-1 border-bottom-dash">
                <div class="col-1 col-vc-hc @GetElementColorClass(BaZiDefine.RestrictBy[info.RiZhu])">@BaZiDefine.RestrictBy[info.RiZhu].ToWuXingString()</div>
                <div class="col-3 col-vc-hc">正官/七殺</div>
                <div class="col-6 col-vc-hl">
                    工作、老闆<br />
                    @if (info.Gender == Sex.Male) {
                        <text>小孩</text>
                    } else {
                        <text>婚姻、感情、另一半</text>
                    }
                </div>
            </div>
            <div class="row ms-1 me-1 border-bottom-dash">
                <div class="col-1 col-vc-hc @GetElementColorClass(BaZiDefine.Generation[info.RiZhu])">@BaZiDefine.Generation[info.RiZhu].ToWuXingString()</div>
                <div class="col-3 col-vc-hc">食神/傷官</div>
                <div class="col-6">
                    文昌、考試運<br />
                    員工、客戶、商品<br />
                    創造力、記憶力、思考力<br />
                    技術、專業、口才、表達能力、膽量
                    @if (info.Gender == Sex.Female) {
                        <br />
                        <text>小孩</text>
                    }
                </div>
            </div>
            <div class="row ms-1 me-1 border-bottom-dash">
                <div class="col-1 col-vc-hc @GetElementColorClass(BaZiDefine.GenerateBy[info.RiZhu])">@BaZiDefine.GenerateBy[info.RiZhu].ToWuXingString()</div>
                <div class="col-3 col-vc-hc">正印/偏印</div>
                <div class="col-6 col-vc-hl">
                    女性長輩、母親
                </div>
            </div>
            <div class="row ms-1 me-1">
                <div class="col-1 col-vc-hc @GetElementColorClass(info.RiZhu)">@info.RiZhu.ToWuXingString()</div>
                <div class="col-3 col-vc-hc">比肩/劫財</div>
                <div class="col-6 col-vc-hl">
                    平輩、朋友<br />
                    兄弟姊妹
                </div>
            </div>
        </div>
        @if (fuYinResult.HasFuYin || fanYinResult.HasFanYin) {
            <hr class="overview-section-divider" aria-hidden="true" />
            <p class="text-secondary mb-4">
                <strong>伏吟與反吟是補充判讀，必須連同喜忌、宮位及其他合沖一起看。</strong>
            </p>
        }

        @if (fuYinResult.HasFuYin) {
            <div class="card analysis-card p-4 mb-4">
                <h5 class="card-title analysis-card-title">
                    <i class="fa-solid fa-repeat me-2" aria-hidden="true"></i>命盤伏吟
                </h5>
                <p class="analysis-card-description text-secondary">
                    四柱中有天干、地支完全相同的柱。
                </p>
                <hr class="analysis-card-divider" aria-hidden="true" />
                <ul>
                    @foreach (var match in fuYinResult.Matches) {
                        <li class="mb-3" @key="match">
                            <AnalysisItem CssClass="mb-0" AlertClass="alert-info">
                                <ChildContent>
                                    <strong>@string.Join("、", match.PillarNames)</strong>
                                    同為
                                    <strong>
                                        <span class="@GetElementColorClass(match.Gan.ToWuXing())">@match.Gan.ToGanString()</span><span class="@GetElementColorClass(match.Zhi.ToWuXing())">@match.Zhi.ToZhiString()</span>
                                    </strong>
                                    。
                                </ChildContent>
                                <ExplanationContent>@match.Situation</ExplanationContent>
                            </AnalysisItem>
                        </li>
                    }
                </ul>

                @if (!fuYinResult.IncludesHourPillar) {
                    <div class="alert alert-info analysis-item-explanation">
                        因出生時辰不確定，本次未將時柱納入伏吟判斷；補齊準確時辰後，結果可能改變。
                    </div>
                }

                <TopicNotice CssClass="mt-3 mb-0">
                    <ul class="compatibility-note-list mb-0">
                        <li class="mb-1"><span class="text-warning">情緒敏感</span>&ensp;命局伏吟的人，心思通常比一般人細密，但也容易多愁善感、庸人自擾</li>
                        <li class="mb-1"><span class="text-warning">內耗較重</span>&ensp;遇到事情容易在心裡轉好幾圈、想太多</li>
                        <li class="mb-1"><span class="text-success">因應之道</span>&ensp;<strong>學會放下執著</strong>，避免過度悲觀或反覆猶豫；多做實事、少想壞事，把心力轉移到充實自我或穩健理財上</li>
                    </ul>
                </TopicNotice>
            </div>
        }

        @if (fanYinResult.HasFanYin) {
            <div class="card analysis-card p-4 mb-4">
                <h5 class="card-title analysis-card-title">
                    <i class="fa-solid fa-repeat me-2" aria-hidden="true"></i>命盤反吟
                </h5>
                <p class="analysis-card-description text-secondary">
                    四柱中有天干相剋、地支相剋相沖的狀況
                </p>
                <hr class="analysis-card-divider" aria-hidden="true" />
                <ul>
                    @foreach (var match in fanYinResult.Matches) {
                        <li class="mb-3" @key="match">
                            <AnalysisItem CssClass="mb-0" AlertClass="alert-warning">
                                <ChildContent>
                                    <strong>@match.Pillars[0].Id</strong>
                                    <span class="@GetElementColorClass(match.Pillars[0].Gan.ToWuXing())">@match.Pillars[0].Gan.ToGanString()</span><span class="@GetElementColorClass(match.Pillars[0].Zhi.ToWuXing())">@match.Pillars[0].Zhi.ToZhiString()</span>
                                    &nbsp;與&nbsp;
                                    <strong>@match.Pillars[1].Id</strong>
                                    <span class="@GetElementColorClass(match.Pillars[1].Gan.ToWuXing())">@match.Pillars[1].Gan.ToGanString()</span><span class="@GetElementColorClass(match.Pillars[1].Zhi.ToWuXing())">@match.Pillars[1].Zhi.ToZhiString()</span>
                                    &nbsp;相剋相沖
                                </ChildContent>
                                <ExplanationContent>@match.Situation</ExplanationContent>
                            </AnalysisItem>
                        </li>
                    }
                </ul>

                @if (!fanYinResult.IncludesHourPillar) {
                    <div class="alert alert-info analysis-item-explanation">
                        因出生時辰不確定，本次未將時柱納入反吟判斷；補齊準確時辰後，結果可能改變。
                    </div>
                }

                <TopicNotice CssClass="mt-3 mb-0">
                    <ul class="compatibility-note-list mb-0">
                        <li class="mb-1"><span class="text-warning">心態反覆</span>&ensp;命局反吟的人，想法容易反覆、缺乏安全感</li>
                        <li class="mb-1"><span class="text-warning">生活變動</span>&ensp;一生中常面臨工作轉換、搬家或人際關係的劇烈洗牌</li>
                        <li class="mb-1"><span class="text-success">化解原則</span>&ensp;行事宜求「穩」、保持定力，多修身養性以減少內心衝突</li>
                        <li class="mb-1"><span class="text-success">大運流年</span>&ensp;當遇到適合的大運或流年，或可將相沖的柱給合走，在大運或流年的時間內會讓反吟的狀況減輕</li>
                    </ul>
                </TopicNotice>
            </div>
        }
    </div>
}

@code {
    private string GetStrengthBadgeClass(GeJu geJu) {
        return geJu switch {
            GeJu.CongQiang => "bg-primary",
            GeJu.ShenQiang => "bg-success",
            GeJu.ShenRuo => "bg-warning text-dark",
            GeJu.CongRuo => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private static string GetStrengthStatusText(BaZiInfo info) {
        return info.RequiresStrengthVerification
            ? $"疑似{info.StrengthStatus.ToGeJuString()}"
            : info.StrengthStatus.ToGeJuString();
    }

    private string GetElementColorClass(WuXing element) {
        return element switch {
            WuXing.Mu => "element-wood",
            WuXing.Huo => "element-fire",
            WuXing.Tu => "element-earth",
            WuXing.Jin => "element-metal",
            WuXing.Shui => "element-water",
            _ => ""
        };
    }

    private MarkupString GetGeJuDesc(BaZiInfo info) {
        string desc;
        switch (info.StrengthStatus) {
            case GeJu.ShenQiang:
                desc = string.Format(
                    @"<div>八字裡的 <span class=""{0}"">{1}</span> 能量較強，應削弱、耗洩 <span class=""{0}"">{1}</span> 能量</div>
<br/>
<div><strong>喜&ensp;&ensp;歡：</strong> <span class=""{2}"">{3}</span>、<span class=""{4}"">{5}</span>、<span class=""{6}"">{7}</span></div>
<div><strong>不喜歡：</strong> <span class=""{8}"">{9}</span>、<span class=""{0}"">{1}</span></div>",
                    GetElementColorClass(info.RiZhu),
                    info.RiZhu.ToWuXingString(),
                    GetElementColorClass(BaZiDefine.RestrictBy[info.RiZhu]),
                    BaZiDefine.RestrictBy[info.RiZhu].ToWuXingString(),
                    GetElementColorClass(BaZiDefine.Restricting[info.RiZhu]),
                    BaZiDefine.Restricting[info.RiZhu].ToWuXingString(),
                    GetElementColorClass(BaZiDefine.Generation[info.RiZhu]),
                    BaZiDefine.Generation[info.RiZhu].ToWuXingString(),
                    GetElementColorClass(BaZiDefine.GenerateBy[info.RiZhu]),
                    BaZiDefine.GenerateBy[info.RiZhu].ToWuXingString()
                );
                break;
            case GeJu.ShenRuo:
                desc = string.Format(
                    @"<div>八字裡的 <span class=""{0}"">{1}</span> 能量較薄弱，應加強 <span class=""{0}"">{1}</span> 能量</div>
<br/>
<div><strong>喜&ensp;&ensp;歡：</strong> <span class=""{8}"">{9}</span>、<span class=""{0}"">{1}</span></div>
<div><strong>不喜歡：</strong> <span class=""{2}"">{3}</span>、<span class=""{4}"">{5}</span>、<span class=""{6}"">{7}</span></div>",
                    GetElementColorClass(info.RiZhu),
                    info.RiZhu.ToWuXingString(),
                    GetElementColorClass(BaZiDefine.RestrictBy[info.RiZhu]),
                    BaZiDefine.RestrictBy[info.RiZhu].ToWuXingString(),
                    GetElementColorClass(BaZiDefine.Restricting[info.RiZhu]),
                    BaZiDefine.Restricting[info.RiZhu].ToWuXingString(),
                    GetElementColorClass(BaZiDefine.Generation[info.RiZhu]),
                    BaZiDefine.Generation[info.RiZhu].ToWuXingString(),
                    GetElementColorClass(BaZiDefine.GenerateBy[info.RiZhu]),
                    BaZiDefine.GenerateBy[info.RiZhu].ToWuXingString()
                );
                break;
            case GeJu.CongQiang:
                desc = string.Format(
                    @"<div>八字裡幫助 <span class=""{0}"">{1}</span> 能量的五行過多、其他五行太少，目前屬疑似從強格。先用多個大運與流年的實際事件確認旺勢是否專一；確認成格後，才順從大勢並補充幫助 <span class=""{0}"">{1}</span> 的能量</div>
<br/>
<div><strong>喜&ensp;&ensp;歡：</strong> <span class=""{8}"">{9}</span>、<span class=""{0}"">{1}</span></div>
<div><strong>不喜歡：</strong> <span class=""{2}"">{3}</span>、<span class=""{4}"">{5}</span>、<span class=""{6}"">{7}</span></div>",
                    GetElementColorClass(info.RiZhu),
                    info.RiZhu.ToWuXingString(),
                    GetElementColorClass(BaZiDefine.RestrictBy[info.RiZhu]),
                    BaZiDefine.RestrictBy[info.RiZhu].ToWuXingString(),
                    GetElementColorClass(BaZiDefine.Restricting[info.RiZhu]),
                    BaZiDefine.Restricting[info.RiZhu].ToWuXingString(),
                    GetElementColorClass(BaZiDefine.Generation[info.RiZhu]),
                    BaZiDefine.Generation[info.RiZhu].ToWuXingString(),
                    GetElementColorClass(BaZiDefine.GenerateBy[info.RiZhu]),
                    BaZiDefine.GenerateBy[info.RiZhu].ToWuXingString()
                );
                break;
            case GeJu.CongRuo:
                desc = string.Format(
                    @"<div>八字裡幫助 <span class=""{0}"">{1}</span> 能量的五行過少，目前屬疑似從弱格。先用多個大運與流年的實際事件確認主勢；確認成格後，才順從剋、洩、耗方向，不再強行補充幫助 <span class=""{0}"">{1}</span> 的能量</div>
<br/>
<div><strong>喜&ensp;&ensp;歡：</strong> <span class=""{2}"">{3}</span>、<span class=""{4}"">{5}</span>、<span class=""{6}"">{7}</span>
<div><strong>不喜歡：</strong> <span class=""{8}"">{9}</span>、<span class=""{0}"">{1}</span>",
                    GetElementColorClass(info.RiZhu),
                    info.RiZhu.ToWuXingString(),
                    GetElementColorClass(BaZiDefine.RestrictBy[info.RiZhu]),
                    BaZiDefine.RestrictBy[info.RiZhu].ToWuXingString(),
                    GetElementColorClass(BaZiDefine.Restricting[info.RiZhu]),
                    BaZiDefine.Restricting[info.RiZhu].ToWuXingString(),
                    GetElementColorClass(BaZiDefine.Generation[info.RiZhu]),
                    BaZiDefine.Generation[info.RiZhu].ToWuXingString(),
                    GetElementColorClass(BaZiDefine.GenerateBy[info.RiZhu]),
                    BaZiDefine.GenerateBy[info.RiZhu].ToWuXingString()
                );
                break;
            default:
                throw new System.ComponentModel.InvalidEnumArgumentException("StrengthStatus", (int)info.StrengthStatus, typeof(GeJu));
        }
        return (MarkupString)desc;
    }

    private MarkupString GetRiZhuDesc(BaZiInfo info) {
        string desc;
        string obj;
        string comment;
        switch (info.DayZhu.Gan) {
            case TianGan.Jia:
                obj = "大樹";
                comment = "堅強、有原則、領導開創者、格局大";
                break;
            case TianGan.Yi:
                obj = "藤蔓";
                comment = "柔軟靈活、協調者、適應力強";
                break;
            case TianGan.Bing:
                obj = "太陽";
                comment = "開朗、熱情、照顧他人、情緒鮮明、好勝、被注目、不服輸";
                break;
            case TianGan.Ding:
                obj = "燭火";
                comment = "溫暖細膩、專注、內斂持久、觀察力佳、照顧者";
                break;
            case TianGan.Wu:
                obj = "高山";
                comment = "可靠、包容、固執、壓迫感";
                break;
            case TianGan.Ji:
                obj = "田土";
                comment = "細膩、培育滋養、適應力強、溫厚務實";
                break;
            case TianGan.Geng:
                obj = "鋼鐵";
                comment = "果決、果斷、敢衝敢拚、正義感強、情緒直接";
                break;
            case TianGan.Xin:
                obj = "珠寶";
                comment = "品味高雅、細節、追求完美、處事彈性、有自知之明、借力使力";
                break;
            case TianGan.Ren:
                obj = "大海";
                comment = "心胸開闊、智慧包容、善於溝通、大鳴大放、冒險家、做啥大家都知道";
                break;
            case TianGan.Gui:
                obj = "雨露";
                comment = "默默堅持、長跑、敏感體貼、觀察入微、見解精闢、默默來、支持者/顧問/知心朋友";
                break;
            default:
                throw new System.ComponentModel.InvalidEnumArgumentException(nameof(info.DayZhu.Gan), (int)info.DayZhu.Gan, typeof(TianGan));
        }
        desc = string.Format(
            @"<div><strong>代表物：</strong> {0}</div><div><strong>描&ensp;&ensp;述：</strong> {1}</div>",
            obj,
            comment
        );
        return (MarkupString)desc;
    }
