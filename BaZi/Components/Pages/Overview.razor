@page "/overview"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<BaZiState> BaZiState
@inject NavigationManager Navigation
@inject PersonalOverviewService OverviewService

@if (BaZiState.Value.Info is null) {
    <div class="alert alert-info">請先回首頁輸入生日。</div>
    <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/")'>回首頁</button>
} else {
    var info = BaZiState.Value.Info;
    var overview = OverviewService.Analyze(info);

    <div class="container overview-page mt-4 mb-5">
        <h2 class="mb-2 text-center"><i class="fa-solid fa-user-tag me-2"></i>個人概述</h2>

        <TenGodProfileCard Info="info" />
        <hr class="overview-section-divider" aria-hidden="true" />

        <div class="row g-4 mt-1">
            @foreach (var card in overview.Cards) {
                <div class="col-12 col-xl-6" @key="card.Title">
                    <OverviewTopicCard Card="card" />
                </div>
            }
        </div>
    </div>
}
