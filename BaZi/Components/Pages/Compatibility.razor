@page "/compatibility/{Relationship}"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<BaZiState> BaZiState
@inject CompatibilityService CompatibilityService
@inject NavigationManager Navigation

@if (BaZiState.Value.Info is null) {
    <div class="alert alert-info mt-4">請先完成自己的八字排盤，再進行合盤。</div>
    <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/")'>回首頁</button>
} else {
    <div class="compatibility-page container mt-4">
        <header class="mb-4">
            <div class="text-uppercase text-secondary small fw-bold">合盤</div>
            <h1 class="h2 mb-2">@CompatibilityRelationshipCatalog.GetDisplayName(_relationship)</h1>
            <p class="text-secondary mb-0">@CompatibilityRelationshipCatalog.GetDescription(_relationship)</p>
        </header>

        <CompatibilityBirthForm @key="_relationship" OnSubmit="HandleSubmit" />

        @if (!string.IsNullOrWhiteSpace(_error)) {
            <div class="alert alert-danger">@_error</div>
        }

        @if (_result is not null) {
            <CompatibilityResultView Result="_result" />

            @if (_relationship == CompatibilityRelationship.Romance
                && _result.InternetSourceSections.Count > 0) {
                <hr class="overview-section-divider" aria-hidden="true" />
                <p class="text-secondary mb-4">
                    <strong>下方非 《徐玉蘭的人生八字應用課》 的內容，來源為網路</strong>
                </p>

                @foreach (var section in _result.InternetSourceSections) {
                    <div class="card p-4 mb-4 compatibility-section @GetToneClass(section.Tone)" @key="section.Title">
                        <h5 class="card-title border-bottom pb-2">
                            <i class="fa-solid @GetToneIcon(section.Tone) me-2"></i>@section.Title
                        </h5>
                        <p><OverviewRichText Text="@section.Summary" /></p>
                        @if (section.Details.Count > 0) {
                            <ul class="mb-0">
                                @foreach (var detail in section.Details) {
                                    <li class="mb-2" @key="detail">
                                        <OverviewRichText Text="@detail" />
                                    </li>
                                }
                            </ul>
                        }
                        @if (section.Notes is { Count: > 0 }) {
                            <div class="topic-notice mt-3 mb-0">
                                <i class="fa-solid fa-circle-info topic-notice-icon" aria-hidden="true"></i>
                                <ul class="compatibility-note-list mb-0">
                                    @foreach (var note in section.Notes) {
                                        <li class="mb-1" @key="note">
                                            <OverviewRichText Text="@note" />
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }
            }
        }
    </div>
}

@code {
    private CompatibilityRelationship _relationship;
    private CompatibilityRelationship? _loadedRelationship;
    private CompatibilityResult? _result;
    private string? _error;

    [Parameter]
    public string? Relationship { get; set; }

    protected override void OnParametersSet() {
        if (!CompatibilityRelationshipCatalog.TryParse(Relationship, out var relationship)) {
            Navigation.NavigateTo("/not-found");
            return;
        }

        _relationship = relationship;
        if (_loadedRelationship != relationship) {
            _loadedRelationship = relationship;
            _result = null;
            _error = null;
        }
    }

    private Task HandleSubmit(CompatibilityBirthInput input) {
        try {
            _error = null;
            _result = CompatibilityService.Analyze(BaZiState.Value.Info!, input, _relationship);
        } catch (Exception ex) {
            _result = null;
            _error = $"分析失敗：{ex.Message}";
        }

        return Task.CompletedTask;
    }

    private static string GetToneClass(CompatibilityTone tone) {
        return tone switch {
            CompatibilityTone.Positive => "border-success",
            CompatibilityTone.Caution => "border-warning",
            CompatibilityTone.Notice => "border-info",
            _ => "border-secondary"
        };
    }

    private static string GetToneIcon(CompatibilityTone tone) {
        return tone switch {
            CompatibilityTone.Positive => "fa-circle-check text-success",
            CompatibilityTone.Caution => "fa-triangle-exclamation text-warning",
            CompatibilityTone.Notice => "fa-circle-info text-info",
            _ => "fa-compass"
        };
    }
}
